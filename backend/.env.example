# Copy to .env and fill in. Never commit .env.
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1

# Local PostgreSQL. If DATABASE_URL is set (e.g. Neon), it takes precedence over DB_*.
DB_NAME=careerpipeline
DB_USER=career_user
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432
# DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require

# Frontend origins allowed to call the API with credentials (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Local: Lax + not secure. Production (cross-site Vercel -> Render): None + True.
REFRESH_COOKIE_SECURE=False
REFRESH_COOKIE_SAMESITE=Lax

# Public demo account created/reset by `python manage.py seed_demo`
DEMO_EMAIL=demo@careerpipeline.dev
DEMO_PASSWORD=DemoPipeline2026!
